{
  "name": "@wenaixi/dsh-superpower",
  "version": "7.2.0",
  "description": "obra/superpowers 的 DSH 移植版 — 将完整的多智能体开发方法论以原生 DSH 技能开箱即用",
  "type": "module",
  "main": "lib/superpowers.js",
  "types": "lib/superpowers.d.ts",
  "files": [
    "lib/",
    "skills/",
    "locale/",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts 2>&1 || echo \"(no eslint config — skipped)\"",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "verify": "node scripts/verify.mjs && node scripts/check-skill-switches.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 <0.3.0-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cosmokit": "~1.8.5",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wenaixi/dsh-superpower"
  },
  "homepage": "https://github.com/Wenaixi/dsh-superpower",
  "bugs": {
    "url": "https://github.com/Wenaixi/dsh-superpower/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "superpowers",
    "skills",
    "agent",
    "methodology"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/superpowers.d.ts",
      "default": "./lib/superpowers.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.png"
}
